# Authentication
AUTH_SECRET="generate-a-long-random-production-secret"

# Google Apps Script backend
NEXT_PUBLIC_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbwSwWsSPEe5uDGLiMRt-H4XH0bz4ICG-S6Dc40YjUVtvt193A5dAz37kUdzA6S-zMc7XQ/exec"
HMAC_SECRET="must-match-the-apps-script-HMAC_SECRET-property"

# Service account for direct (fast) Sheets reads -- see src/lib/sheets-direct.ts.
# Writes still go through Apps Script above; this only speeds up reads.
# GOOGLE_SERVICE_ACCOUNT_KEY = base64 of the full service-account JSON key file.
GOOGLE_SERVICE_ACCOUNT_KEY="base64-encoded-service-account-json"
GOOGLE_SHEET_ID="the-spreadsheet-id-from-its-url"
