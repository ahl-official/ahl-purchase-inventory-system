# Authentication
AUTH_SECRET="generate-a-long-random-production-secret"

# Application accounts
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
PURCHASE_EMAIL="purchase@example.com"
PURCHASE_PASSWORD="replace-with-a-strong-password"
DISTRIBUTOR_EMAIL="distribution@example.com"
DISTRIBUTOR_PASSWORD="replace-with-a-strong-password"

# Google Apps Script backend
NEXT_PUBLIC_APPS_SCRIPT_URL="https://script.google.com/macros/s/DEPLOYMENT_ID/exec"
HMAC_SECRET="must-match-the-apps-script-HMAC_SECRET-property"
